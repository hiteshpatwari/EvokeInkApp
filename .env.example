# Mock mode is deterministic and needs no key.
AI_PROVIDER=mock

# Keep this value server-side. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=1

# Exact public origin allowlist and server-side abuse/spend controls. Native
# Capacitor origins may be listed only while AI_PROVIDER=mock; real-AI native
# access requires a separately verified device-attestation design.
APP_ALLOWED_ORIGINS=http://localhost:3000
# The Node server uses memory locally. Cloudflare production sets this binding
# to cloudflare so every public request uses the atomic Durable Object.
PROMPT_CONTROL_STORE=memory
AI_MAX_REQUEST_BYTES=12000
AI_INSTALLATION_MONTHLY_LIMIT=20
AI_IP_MONTHLY_LIMIT=200
AI_MONTHLY_BUDGET_USD=250
AI_ESTIMATED_REQUEST_COST_USD=0.01
# Set this as a server secret in production; never expose it to clients.
AI_QUOTA_HASH_SECRET=
