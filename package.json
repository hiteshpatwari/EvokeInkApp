{
  "name": "read-and-reflect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.11.1 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit && pnpm mobile:typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "mobile:test": "pnpm --filter @read-and-reflect/mobile test",
    "mobile:typecheck": "pnpm --filter @read-and-reflect/mobile typecheck",
    "mobile:build": "pnpm --filter @read-and-reflect/mobile build",
    "mobile:sync": "pnpm --filter @read-and-reflect/mobile cap:sync",
    "mobile:secrets": "pnpm --filter @read-and-reflect/mobile secrets:check"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@vinext/cloudflare": "1.2.0",
    "jspdf": "4.2.1",
    "next": "16.4.0",
    "openai": "7.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.66.0",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.19",
    "jsdom": "27.2.0",
    "oxlint": "1.87.0",
    "prettier": "3.7.4",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "overrides": {
      "fflate@0.7.3": "0.7.5",
      "xcode@3.0.1>uuid": "11.1.1"
    }
  },
  "packageManager": "pnpm@10.11.1"
}
